# Required for support chat responses
OPENAI_API_KEY=

# Required in production/serverless for durable quote-request persistence.
# Use any Postgres connection string supported by node-postgres.
DATABASE_URL=

# Required to access operator/admin surfaces. Configure as secrets in Vercel.
OPERATOR_AUTH_USERNAME=
OPERATOR_AUTH_PASSWORD=

# Legacy fallback for server-to-server operator calls only. Do not use as the browser operator UX.
QUOTE_REQUEST_OPERATOR_KEY=

# Company OS marketplace V1 (server-side only)
# T6b.1: the store's billing provider, polar (default, merchant of record) or stripe. The store refuses to
# run with a provider whose credentials are missing (one log line at start; its routes answer 503).
FAIVR_BILLING_PROVIDER=polar
# Polar: organization access token of the sandbox or production organization, the webhook endpoint's secret
# (whsec_...), sandbox or production, and the organization id. Sandbox and production tokens are separate.
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_ENVIRONMENT=sandbox
POLAR_ORGANIZATION_ID=
# Stripe: the second implementation; needed only with FAIVR_BILLING_PROVIDER=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
FAIVR_BILLING_SIGNING_PRIVATE_KEY=
FAIVR_BILLING_SIGNING_KEY_ID=

# Exact HTTPS origin that stores signed portable-agent artifacts.
# Package imports and downloads reject every other origin.
FAIVR_PACKAGE_ORIGIN=

# Optional download bound; defaults to 50 MiB.
FAIVR_MAX_PACKAGE_BYTES=52428800
